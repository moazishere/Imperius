# Pilot form delivery (Resend). Copy to .env.local and fill in.
# Without these, requests are only logged in development and fail with an error in production.
RESEND_API_KEY=
# One address, or several separated by commas.
PILOT_EMAIL_TO=
# Must be on a domain verified in Resend. The default test sender only delivers to your own Resend account email.
PILOT_EMAIL_FROM="Imperius <pilot@your-domain.com>"

# Public URL of the site, used for absolute link-preview image URLs (not needed on Vercel).
SITE_URL=
